{
  "appId": "io.github.myselfsislam.setu",
  "appName": "Setu",
  "webDir": "www",
  "backgroundColor": "#F4F2FB",
  "ios": { "contentInset": "never", "limitsNavigationsToAppBoundDomains": false },
  "android": { "allowMixedContent": false },
  "plugins": {
